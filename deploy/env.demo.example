# ══════════════════════════════════════════════════════════════════════════
# 客户体验演示栈的环境变量模板  →  部署时另存为项目根目录的 .env.demo
#
#   cp deploy/env.demo.example .env.demo && vi .env.demo
#   docker compose --profile nginx --profile demo up -d --build
#
# ⚠️ 与生产 .env **完全独立**：演示栈用独立的数据库、独立的 JWT 密钥。
#    这份文件里没有、也不应该有生产库的任何连接信息。
# ⚠️ .env.demo 已被 .gitignore 忽略（`.env.*`），不要把真实密钥提交进仓库。
# ══════════════════════════════════════════════════════════════════════════

APP_ENV=prod
HOST=0.0.0.0
PORT=8000

# ── 演示专用数据库（compose 里的 postgres-demo 容器，与生产库隔离）──
# 密码同时要写进项目根目录 .env 的 DEMO_POSTGRES_PASSWORD（compose 变量插值用）
POSTGRES_PASSWORD=CHANGE_ME_DEMO_DB_PASSWORD
DATABASE_URL=postgresql://flora:CHANGE_ME_DEMO_DB_PASSWORD@postgres-demo:5432/flora_demo

# ── LLM（可复用生产同一把 key；也可单发一把便于成本隔离）──
LLM_API_KEY=sk-REPLACE_ME
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_MAX_ITERATIONS=8
LLM_MAX_TOKENS=3000
LLM_TEMPERATURE=0.7
LLM_REQUEST_TIMEOUT=120
LLM_ENABLE_THINKING=false
LLM_HY_FALLBACK_ENABLED=false

# ── 生图（演示最有说服力的一环；如担心成本可改为 mock）──
IMAGE_PROVIDER=qwen
IMAGE_API_KEY=sk-REPLACE_ME
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
IMAGE_MODEL=qwen-image-3.0
IMAGE_WIDTH=768
IMAGE_HEIGHT=1024
IMAGE_PUBLIC_BASE_URL=

# ── 鉴权：演示用「匿名登录」换 JWT（每次访问都是全新访客，互不串数据）──
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_STRING
JWT_EXPIRE_HOURS=24
AUTH_REQUIRED=true
ANONYMOUS_LOGIN_ENABLED=true
# 演示实例自带一枚平台密钥，不复用生产 key
PLATFORM_API_KEYS=demo=CHANGE_ME_RANDOM

# 前端与接口同源（经 nginx /demo/ 与 /demo-api/），无需放开通配 CORS
ALLOWED_ORIGINS=https://api.tiaowulan.com

# ── 成本与并发护栏（演示收紧，防被刷）──
LLM_COST_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
AGENT_MAX_CONCURRENCY=4
IMAGE_TASK_MAX_WORKERS=2
IMAGE_TASK_QUEUE_MAX=20

# ── 演示不需要的：关掉省成本 ──
MEMORY_CONSOLIDATE_ENABLED=false
LEARNING_WEBHOOK_SECRET=
EMBEDDING_PROVIDER=
RAG_GAP_LOG_ENABLED=false
DIY_LLM_REQUIREMENT_ENABLED=true
AGENT_PAGE_ENABLED=true

# ── 平台只读数据源（让演示能查到真实在售商品与真实营业店铺）──
# 这是**平台侧只读接口**，不是我们的数据库。
PLATFORM_API_AISTORE_URL=https://aistore.xiangbinmeigui.com
