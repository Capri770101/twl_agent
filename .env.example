# ═══════════════════════════════════════════════════════════
# 花艺智能体 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ═══════════════════════════════════════════════════════════

# ── 服务配置 ──
APP_ENV=prod
HOST=0.0.0.0
PORT=8000

# ── 数据库（生产必填 PostgreSQL，禁止 SQLite）──
# 方式一：使用 docker-compose 自带的 postgres 容器（推荐，POSTGRES_PASSWORD 见下方）
DATABASE_URL=postgresql://flora:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/flora_agent
# 方式二：使用外部/云数据库
# DATABASE_URL=postgresql://user:password@host:5432/flora_agent

# docker-compose 中 postgres 容器的密码（仅使用自带 postgres 时需要）
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# ── 目标平台外部数据源（可选；与智能体内部数据库隔离）──
# 仅在服务端配置，LLM 不会看到连接串；首期连接器支持 PostgreSQL。
# PLATFORM_DB_MAIN_URL=postgresql://readonly_user:password@platform-db:5432/platform

# ── LLM 大模型（必填，二选一）──
# 方式一：使用 OpenAI 兼容接口
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_ITERATIONS=8
LLM_REQUEST_TIMEOUT=120

# 方式二：使用 hy 大模型（推荐）
HY_API_KEY=sk-xxx
HY_BASE_URL=https://tokenhub.tencentmaas.com/v1/responses
HY_LLM_MODEL=hy3
HY_IMAGE_MODEL=Hy-Image-3.0

# ── 文生图（效果图生成）──
# 已实现：mock / qwen（阿里云百炼）/ hy（腾讯）；flux / dall-e / kling / comfyui 仅占位、会回落 mock
# 用 qwen 时（以 Qwen-Image-3.0 为例）：
#   IMAGE_PROVIDER=qwen
#   IMAGE_API_KEY=sk-xxx            # 百炼 API Key
#   IMAGE_MODEL=qwen-image-3.0
#   IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# 坑：qwen-image **不走** OpenAI 兼容的 /images/generations（实测 404），必须走上面原生接口；
#     尺寸格式是 "宽*高"（非 "宽x高"）；返回带签名有时效的 OSS 地址，代码会立即下载转存。
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_WIDTH=768
IMAGE_HEIGHT=1024
# 生图结果公网前缀（留空则用本服务 /generated 相对路径；生产建议指向 CDN/对象存储域名）
IMAGE_PUBLIC_BASE_URL=

# ── 成本护栏①：LLM token 日预算（可选，防 token 计费失控）──
# 三项需同时满足才真正生效：LLM_COST_ENABLED=true、配置了 REDIS_URL、对应预算 > 0；
# 缺任一条件则**静默放行**（故障不影响主链路，仅失去预算约束）。按自然日重置。
LLM_COST_ENABLED=true
# 全局日预算（所有用户合计 token 数），0 = 不限制；建议按实际预算设正数
LLM_GLOBAL_DAILY_TOKEN_BUDGET=0
# 单用户日预算，0 = 不限制
LLM_USER_DAILY_TOKEN_BUDGET=0

# ── 成本护栏②：请求限流（进程内固定窗口，默认开启）──
# 单用户每分钟最多 RATE_LIMIT_PER_MINUTE 次 /chat 调用；超限返回 429 + Retry-After。
# 多实例部署时各实例独立计数（如需全局精确限流，需将 backend/rate_limit.py 换 Redis 后端）。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# ── Redis（可选，仅 token 预算计数需要）──
# 不配置时预算护栏静默放行；请求限流为进程内实现，不依赖 Redis。
REDIS_URL=

# ── CORS ──
# 开发环境可使用 *；生产环境必须填写明确域名，多个域名用逗号分隔
ALLOWED_ORIGINS=https://your-miniprogram.com,https://your-h5.com

# ── 鉴权（生产必填）──
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_EXPIRE_HOURS=720
# 开发环境可设 false；生产环境会强制 true
AUTH_REQUIRED=true

# ── 多平台接入（推荐配置）──
# 平台级 API Key，格式 "platform_id=key"，多个用逗号或换行分隔。
# 配置后接入方后端通过 POST /auth/token + X-API-Key 为自己的用户换取智能体 token。
# 生成方式示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_API_KEYS=wxmini=REPLACE_WITH_RANDOM_KEY_1,h5app=REPLACE_WITH_RANDOM_KEY_2
# 匿名登录仅用于开发联调；生产环境未显式设置时自动关闭。生产如确需开启，须显式写 true 并自担风险。
# ANONYMOUS_LOGIN_ENABLED=false

# ── 运维 / 接入期工具开关（默认关闭）──
# 关闭时，8 个平台接入工具（platform_db_discover / _test_connection / _sample_table
# 与 platform_mapping_draft / _save_draft / _list_drafts / _set_status / _get_active）
# 不暴露给 C 端会话、也不可被调用；C 端只用 13 个功能工具。
# 仅在部署接入期临时置 true，供配置方通过对话完成结构与映射接入；日常运营保持 false。
# ENABLE_OPS_TOOLS=false

# ── 调用监控面板密钥（必填，未配置时 /api/metrics 一律 503）──
# 面板登录用，与业务 JWT_SECRET 区分；建议 openssl rand -hex 32 生成高强度串
# 注意：密钥较短或外泄都会让监控面板裸奔，请妥善保管，必要时随时在 .env 改值后重启 agent
DASHBOARD_API_KEY=REPLACE_WITH_RANDOM_KEY

# ── 微信小程序登录（可选，仅启用 /auth/wx-login 时需要）──
# 兼容 WX_APPID/WX_SECRET 与 WECHAT_APPID/WECHAT_SECRET，两组只需配置一组
WECHAT_APPID=
WECHAT_SECRET=

# ── 智谱视觉 MCP（可选）──
ZHIPU_API_KEY=
