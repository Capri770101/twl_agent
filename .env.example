# ═══════════════════════════════════════════════════════════
# 花艺智能体 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ═══════════════════════════════════════════════════════════

# ── 服务配置 ──
APP_ENV=prod
HOST=0.0.0.0
PORT=8000

# ── 数据库（生产必填 PostgreSQL，禁止 SQLite）──
# 方式一：使用 docker-compose 自带的 postgres 容器（推荐，POSTGRES_PASSWORD 见下方）
DATABASE_URL=postgresql://flora:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/flora_agent
# 方式二：使用外部/云数据库
# DATABASE_URL=postgresql://user:password@host:5432/flora_agent

# docker-compose 中 postgres 容器的密码（仅使用自带 postgres 时需要）
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# ── 目标平台外部数据源（可选；与智能体内部数据库隔离）──
# 两种只读来源，**DB 优先**：未配库（或未配 active mapping）时才落到 REST。
# 方式一：直连只读库（需要平台提供只读连接串 + 配置 active mapping）
# PLATFORM_DB_MAIN_URL=postgresql://readonly_user:password@platform-db:5432/platform
# 方式二：平台 REST 只读接口（免 mapping，直接可查商品/店铺；order/user 平台未开放）
#   实体映射：plan → {base}/v1/merchant/products、shop → {base}/v1/merchant/shops
#   可选 TOKEN：仅在需要鉴权的端点使用（平台多数接口匿名可读）
# PLATFORM_API_AISTORE_URL=https://aistore.xiangbinmeigui.com
# PLATFORM_API_AISTORE_TOKEN=
#
# REST 通路的进程内缓存有效期（秒）。平台列表接口不支持查询参数（过滤在本地做），
# 每次查询都是「拉全量」；一轮咨询模型常查 2~4 次，缓存后同一轮只走一次网络。
# 设 0 关闭缓存。默认 60。
# PLATFORM_HTTP_CACHE_TTL=60

# ── LLM 大模型（必填，二选一）──
# 方式一：使用 OpenAI 兼容接口
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_ITERATIONS=8
LLM_REQUEST_TIMEOUT=120

# 方式二：使用 hy 大模型（可选兜底 provider，默认关闭）
HY_API_KEY=sk-xxx
HY_BASE_URL=https://tokenhub.tencentmaas.com/v1/responses
HY_LLM_MODEL=hy3
HY_IMAGE_MODEL=Hy-Image-3.0

# ── LLM 行为微调（可选，留空用默认值）──
# 是否启用 hy 作为兜底 provider；关闭时只用主 LLM，避免跨厂商风格跳变
LLM_HY_FALLBACK_ENABLED=false
# 是否开启模型思考模式。阿里云百炼 Qwen3 等开启后首字延迟显著变长，对话场景建议关闭
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=3000
LLM_TEMPERATURE=0.7

# ── 文生图（效果图生成）──
# 已实现：mock / qwen（阿里云百炼）/ hy（腾讯）；flux / dall-e / kling / comfyui 仅占位、会回落 mock
# 用 qwen 时（以 Qwen-Image-3.0 为例）：
#   IMAGE_PROVIDER=qwen
#   IMAGE_API_KEY=sk-xxx            # 百炼 API Key
#   IMAGE_MODEL=qwen-image-3.0
#   IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# 坑：qwen-image **不走** OpenAI 兼容的 /images/generations（实测 404），必须走上面原生接口；
#     尺寸格式是 "宽*高"（非 "宽x高"）；返回带签名有时效的 OSS 地址，代码会立即下载转存。
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_WIDTH=768
IMAGE_HEIGHT=1024
# 生图结果公网前缀（留空则用本服务 /generated 相对路径；生产建议指向 CDN/对象存储域名）
IMAGE_PUBLIC_BASE_URL=

# ── 成本护栏①：LLM token 日预算（可选，防 token 计费失控）──
# 三项需同时满足才真正生效：LLM_COST_ENABLED=true、配置了 REDIS_URL、对应预算 > 0；
# 缺任一条件则**静默放行**（故障不影响主链路，仅失去预算约束）。按自然日重置。
LLM_COST_ENABLED=true
# 全局日预算（所有用户合计 token 数），0 = 不限制；建议按实际预算设正数
LLM_GLOBAL_DAILY_TOKEN_BUDGET=0
# 单用户日预算，0 = 不限制
LLM_USER_DAILY_TOKEN_BUDGET=0

# ── 成本护栏②：请求限流（进程内固定窗口，默认开启）──
# 单用户每分钟最多 RATE_LIMIT_PER_MINUTE 次 /chat 调用；超限返回 429 + Retry-After。
# 多实例部署时各实例独立计数（如需全局精确限流，需将 backend/rate_limit.py 换 Redis 后端）。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
# 附加按**来源 IP** 限流（0 = 关闭；生产保持 0 即可，行为零变化）。
# 仅公开演示场景需要：演示页每次访问都会领一个全新匿名身份，只按 user_id 限流挡不住刷量。
RATE_LIMIT_IP_PER_MINUTE=0

# ── Redis（可选，仅 token 预算计数需要）──
# 不配置时预算护栏静默放行；请求限流为进程内实现，不依赖 Redis。
REDIS_URL=

# ── 智能体单轮预算与并发护栏（可选）──
# 一次对话最多几轮 ReAct 推理 / 单次请求端到端超时（秒，超时主动收口，不再裸跑）
MAX_ITERATIONS=8
REQUEST_TIMEOUT=180
# 同时在跑的智能体轮次上限；超出**快速失败(503 + Retry-After)**而不是无限排队
AGENT_MAX_CONCURRENCY=8
# ── 官网演示页体验窗（www.tiaowulan.com/agent.html 调用 POST /api/agent/query）──
# 关闭时端点表现为 404（未准备好时不被扫到）。单轮、无状态、纯规则引擎（不烧 LLM）
AGENT_PAGE_ENABLED=true
# 适配层计算总超时（秒）；超时后页面会自动降级回它自己的 demo 引擎
AGENT_PAGE_TIMEOUT=5
# 输入截断长度（字符），防超长文本刷量
AGENT_PAGE_MAX_INPUT=200
# ⚠️ AGENT_PAGE_MIN_MARGIN 已于 2026-09-18 移除（定价改为「从平台在售商品反推零售价」，
#    再乘加价率等于对零售价二次加价、会把方案顶出用户预算）。填了也不会被读取。
# 记忆：注入多少条历史消息 / 是否自动固化用户偏好 / 每几轮固化一次
HISTORY_LIMIT=20
MEMORY_CONSOLIDATE_ENABLED=true
MEMORY_CONSOLIDATE_EVERY=6

# ── 数据库（开发兜底，生产禁用 SQLite）──
# DB_PATH 仅在 DATABASE_URL 未配置时生效（本地开发用），生产必须用 PostgreSQL
DB_PATH=data/flora.db

# ── CORS ──
# 开发环境可使用 *；生产环境必须填写明确域名，多个域名用逗号分隔
ALLOWED_ORIGINS=https://your-miniprogram.com,https://your-h5.com

# ── 鉴权（生产必填）──
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_EXPIRE_HOURS=720
# 开发环境可设 false；生产环境会强制 true
AUTH_REQUIRED=true

# ── 多平台接入（推荐配置）──
# 平台级 API Key，格式 "platform_id=key"，多个用逗号或换行分隔。
# 配置后接入方后端通过 POST /auth/token + X-API-Key 为自己的用户换取智能体 token。
# 生成方式示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_API_KEYS=wxmini=REPLACE_WITH_RANDOM_KEY_1,h5app=REPLACE_WITH_RANDOM_KEY_2
# 匿名登录仅用于开发联调；生产环境未显式设置时自动关闭。生产如确需开启，须显式写 true 并自担风险。
# ANONYMOUS_LOGIN_ENABLED=false

# ── 运维 / 接入期工具开关（默认关闭）──
# 关闭时，8 个平台接入工具（platform_db_discover / _test_connection / _sample_table
# 与 platform_mapping_draft / _save_draft / _list_drafts / _set_status / _get_active）
# 不暴露给 C 端会话、也不可被调用；C 端只用 13 个功能工具。
# 仅在部署接入期临时置 true，供配置方通过对话完成结构与映射接入；日常运营保持 false。
# ENABLE_OPS_TOOLS=false

# ── 公网接口文档开关（默认关闭，建议生产保持 false）──
# 关闭时 /docs、/redoc、/openapi.json 一律 404。
# 三者匿名可取时会暴露**全部端点的完整 schema**（参数、鉴权头、错误结构），
# 等于把攻击面清单递给对方（2026-09-18 外部安全审计 P0）。
# 需要浏览接口时临时置 true，或向维护方索取 openapi.json。
# API_DOCS_ENABLED=false

# ── 平台数据「可查实体」白名单（留空 = 不限制，生产默认）──
# 逗号分隔：plan(在售商品/方案) / shop(店铺) / order(订单) / user(用户)。
# 体验/演示实例建议设为 plan —— 只走「生成方案 + 给建议」这条主线：
#   schema 里不暴露 shop（模型看不到该选项）、执行层直接拒绝店铺查询、
#   prompt 换用「只做方案与建议」变体（full_platform_plan_only）、不产出店铺卡。
# PLATFORM_ALLOWED_ENTITIES=plan

# ── 调用监控面板密钥（必填，未配置时 /api/metrics 一律 503）──
# 面板登录用，与业务 JWT_SECRET 区分；建议 openssl rand -hex 32 生成高强度串
# 注意：密钥较短或外泄都会让监控面板裸奔，请妥善保管，必要时随时在 .env 改值后重启 agent
DASHBOARD_API_KEY=REPLACE_WITH_RANDOM_KEY

# ── 微信小程序登录（可选，仅启用 /auth/wx-login 时需要）──
# 兼容 WX_APPID/WX_SECRET 与 WECHAT_APPID/WECHAT_SECRET，两组只需配置一组
WECHAT_APPID=
WECHAT_SECRET=

# ── 智谱视觉 MCP（可选）──
ZHIPU_API_KEY=

# ── 生图任务队列（可选，防"一个慢生图拖垮全服务"）──
# 并发生图线程数 / 「在跑 + 排队」总数上限；占不到槽位直接判 failed，不再无界排队
IMAGE_TASK_MAX_WORKERS=2
IMAGE_TASK_QUEUE_MAX=50

# ── 电子贺卡渲染（可选）──
# 中文字体路径留空用内置默认字体；画布尺寸默认 900×1200 竖版卡片
CARD_FONT_PATH=
CARD_WIDTH=900
CARD_HEIGHT=1200

# ── 视觉识图（可选；未配置时相关能力不可用）──
# 允许读取的图片根目录（安全边界，必须显式指定，避免任意路径读取）；单图大小上限（字节）
VISION_ALLOWED_ROOT=
VISION_MAX_IMAGE_BYTES=10485760

# ── 检索观测与语义增强（可选）──
# 检索缺口日志：记录零结果 / 低分查询以发现知识库盲区（默认关闭，仅观测不改库）
RAG_GAP_LOG_ENABLED=false
RAG_GAP_LOG_PATH=
# 真实 embedding 语义通道（默认关闭）。开启前先用评测集标定，涨了再开：
#   EMBEDDING_PROVIDER=dashscope python scripts/eval_retrieval.py --verbose
# 未单独配置 API_KEY / BASE_URL 时复用上方 LLM_*（同厂商可直接复用）
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ── DIY 需求抽取（可选）──
# 在同一次设计调用里让模型顺带输出结构化需求，补正则漏抽的槽位（只补空、不覆盖规则已抽到的值）
DIY_LLM_REQUIREMENT_ENABLED=true

# ── 学习回调（可选）──
# 平台真实订单落定后回调 POST /api/learning/order，把成交方案计入 proven 域（高成交方案优先召回）
# 未配置时该接口一律返回 503（fail-closed，禁止裸奔写入）
LEARNING_WEBHOOK_SECRET=

# ── 腾讯地图（可选，仅位置相关能力需要）──
TENCENT_MAP_KEY=

# ⚠️ 平台下单 API：**请勿配置**。智能体不直接下单、也不调用任何下单接口
# （下单由客户在小程序侧点击商品卡片进入现有结算页完成）。此处仅为兼容旧部署保留。
# PLATFORM_ORDER_API_URL=
# PLATFORM_ORDER_API_KEY=
